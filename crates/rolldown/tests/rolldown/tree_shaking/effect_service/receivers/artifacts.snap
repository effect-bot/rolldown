## main.js

```js
import assert from "node:assert";
// ../node_modules/effect/Effect.js
const EffectProto = { *[Symbol.iterator]() {
	return yield this;
} };
const make = (run) => Object.assign(Object.create(EffectProto), { run });
const gen = (body) => make(async (context, scope) => {
	const iterator = body();
	let input;
	for (;;) {
		const { value, done } = iterator.next(input);
		if (done) return value;
		input = await value.run(context, scope);
	}
});
const closeScope = async (scope) => {
	for (const finalizer of scope.reverse()) await finalizer();
};
const provide = (self, layer) => make(async (context) => {
	const scope = [];
	try {
		return await self.run(await layer.build(context, scope), scope);
	} finally {
		await closeScope(scope);
	}
});
const runPromise = async (self) => {
	const scope = [];
	try {
		return await self.run(/* @__PURE__ */ new Map(), scope);
	} finally {
		await closeScope(scope);
	}
};
// ../node_modules/effect/Context.js
const Service = (key) => {
	const self = make(async (context) => {
		if (!context.has(self.key)) throw new Error(`Service not found: ${self.key}`);
		return context.get(self.key);
	});
	self.key = key;
	self.of = (service) => service;
	self.use = (f) => make(async (context, scope) => f(await self.run(context, scope)).run(context, scope));
	return self;
};
// ../node_modules/effect/Layer.js
function effect(service, effect_) {
	if (arguments.length === 1) return (effect_) => effect(service, effect_);
	return { build: async (context, scope) => new Map(context).set(service.key, await effect_.run(context, scope)) };
}
const mergeAll = (...layers) => ({ build: async (context, scope) => {
	let merged = new Map(context);
	for (const layer of layers) merged = new Map([...merged, ...await layer.build(context, scope)]);
	return merged;
} });
// main.js
const DefaultParam = Service("test/DefaultParam");
const Reassigned = Service("test/Reassigned");
function read() {
	return 1;
}
read = function() {
	return this.unused();
};
const DefaultParamLayer = effect(DefaultParam, gen(function* () {
	return DefaultParam.of({
		read: function(value = this.unused()) {
			return value;
		},
		unused: () => 2
	});
}));
const ReassignedLayer = effect(Reassigned, gen(function* () {
	return {
		read,
		unused: () => 2
	};
}));
const program = gen(function* () {
	return [(yield* DefaultParam).read(), (yield* Reassigned).read()];
});
assert.deepStrictEqual(await runPromise(provide(program, mergeAll(DefaultParamLayer, ReassignedLayer))), [2, 2]);

```
