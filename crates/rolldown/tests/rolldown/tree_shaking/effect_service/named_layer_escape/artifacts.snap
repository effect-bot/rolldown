import assert from "node:assert";
// ../node_modules/effect/Effect.js
const EffectProto = { *[Symbol.iterator]() {
	return yield this;
} };
const make = (run) => Object.assign(Object.create(EffectProto), { run });
// ../node_modules/effect/Context.js
const Service = (key) => {
	const self = make(async (context) => {
		if (!context.has(self.key)) throw new Error(`Service not found: ${self.key}`);
		return context.get(self.key);
	});
	self.key = key;
	self.of = (service) => service;
	self.use = (f) => make(async (context, scope) => f(await self.run(context, scope)).run(context, scope));
	return self;
};
// ../node_modules/effect/Layer.js
function succeed(service, value) {
	if (arguments.length === 1) return (value) => succeed(service, value);
	return { build: async (context) => new Map(context).set(service.key, value) };
}
// main.js
const service = (await succeed(Service("test/Escape"), {
	read: () => 1,
	unused: () => 2
}).build(/* @__PURE__ */ new Map(), [])).get("test/Escape");
assert.strictEqual(service.unused(), 2);

```
