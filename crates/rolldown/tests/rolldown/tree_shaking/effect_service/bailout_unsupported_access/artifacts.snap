import assert from "node:assert";
// ../node_modules/effect/Effect.js
const EffectProto = { *[Symbol.iterator]() {
	return yield this;
} };
const make = (run) => Object.assign(Object.create(EffectProto), { run });
const succeed = (value) => make(async () => value);
const map = (self, f) => make(async (context, scope) => f(await self.run(context, scope)));
const flatMap = (self, f) => make(async (context, scope) => f(await self.run(context, scope)).run(context, scope));
const gen = (body) => make(async (context, scope) => {
	const iterator = body();
	let input;
	for (;;) {
		const { value, done } = iterator.next(input);
		if (done) return value;
		input = await value.run(context, scope);
	}
});
const context = () => make(async (context) => context);
const closeScope = async (scope) => {
	for (const finalizer of scope.reverse()) await finalizer();
};
const provide = (self, layer) => make(async (context) => {
	const scope = [];
	try {
		return await self.run(await layer.build(context, scope), scope);
	} finally {
		await closeScope(scope);
	}
});
const runPromise = async (self) => {
	const scope = [];
	try {
		return await self.run(/* @__PURE__ */ new Map(), scope);
	} finally {
		await closeScope(scope);
	}
};
// ../node_modules/effect/Context.js
const Service = (key) => {
	const self = make(async (context) => {
		if (!context.has(self.key)) throw new Error(`Service not found: ${self.key}`);
		return context.get(self.key);
	});
	self.key = key;
	self.of = (service) => service;
	self.use = (f) => make(async (context, scope) => f(await self.run(context, scope)).run(context, scope));
	return self;
};
const get = (context, service) => context.get(service.key);
// ../node_modules/effect/Layer.js
function effect(service, effect_) {
	if (arguments.length === 1) return (effect_) => effect(service, effect_);
	return { build: async (context, scope) => new Map(context).set(service.key, await effect_.run(context, scope)) };
}
const mergeAll = (...layers) => ({ build: async (context, scope) => {
	let merged = new Map(context);
	for (const layer of layers) merged = new Map([...merged, ...await layer.build(context, scope)]);
	return merged;
} });
// main.js
const A = Service("test/A");
const B = Service("test/B");
const C = Service("test/C");
const D = Service("test/D");
const E = Service("test/E");
const F = Service("test/F");
const unusedA = () => "unusedA";
const unusedB = () => "unusedB";
const unusedC = () => "unusedC";
const unusedD = () => "unusedD";
const unusedE = () => "unusedE";
const unusedF = () => "unusedF";
const provider = (key, unused) => effect(key, gen(function* () {
	const used = () => "used";
	return key.of({
		used,
		unused
	});
}));
const FLayer = effect(F, gen(function* () {
	return F.of({
		used() {
			return this.unused();
		},
		unused: () => unusedF()
	});
}));
const layer = mergeAll(provider(A, () => unusedA()), provider(B, () => unusedB()), provider(C, () => unusedC()), provider(D, () => unusedD()), provider(E, () => unusedE()), FLayer);
const describe = (service) => Object.keys(service).join(",");
const program = gen(function* () {
	const a = yield* map(A, (a) => a.used());
	const b = yield* flatMap(context(), (context) => succeed(get(context, B).used()));
	const c = yield* C.use((c) => succeed(c.used()));
	const d = describe(yield* D);
	const e = yield* E;
	const name = ["un", "used"].join("");
	const f = yield* F;
	return [
		a,
		b,
		c,
		d,
		e[name](),
		f.used()
	];
});
assert.deepStrictEqual(await runPromise(provide(program, layer)), [
	"used",
	"used",
	"used",
	"used,unused",
	"unusedE",
	"unusedF"
]);

