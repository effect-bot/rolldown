+        63 => "const l63 = () => common();".to_string(),
+        _ => format!("const l{i} = () => (l{}(), common());", i + 1),
+    };
+    let chain = (1..64).step_by(2).chain([0]).chain((2..64).step_by(2)).map(link);
+    let source = std::iter::once("const common = () => g();".to_string())
+        .chain(fan_in)
+        .chain(chain)
+        .chain(std::iter::once("common();".to_string()))
+        .collect::<Vec<_>>()
+        .join("\n");
+    test_options_with_iterations(
+        &source,
+        "const common = () => g(); common();",
+        1,
+        &CompressOptions::dce(),
+    );
