+
+fn dead_chain(links: usize, link: impl Fn(usize) -> String) -> String {
+    (0..links).map(link).collect::<Vec<_>>().join("\n")
+}
+
+// A dead chain of declarators goes in one pass whichever way its links
+// point. A chain longer than the fixed-point guard used to trip it.
+#[test]
+fn remove_dead_declarator_chain_in_one_pass() {
+    let options = CompressOptions::smallest();
+    let backward = |i: usize| {
+        if i == 0 {
+            "const f0 = () => g();".to_string()
+        } else {
+            format!("const f{i} = () => f{}();", i - 1)
+        }
+    };
+    test_options_with_iterations(&dead_chain(12, backward), "", 1, &options);
+    test_options_with_iterations(&dead_chain(60, backward), "", 1, &options);
+    let forward = |i: usize| {
+        if i == 59 {
+            "let f59 = () => g();".to_string()
+        } else {
+            format!("let f{i} = () => f{}();", i + 1)
+        }
+    };
+    test_options_with_iterations(&dead_chain(60, forward), "", 1, &options);
+    let methods = |i: usize| {
+        if i == 0 {
+            "const o0 = { m() { g() } };".to_string()
+        } else {
+            format!("const o{i} = {{ m() {{ o{}.m() }} }};", i - 1)
+        }
+    };
+    test_options_with_iterations(&dead_chain(13, methods), "", 1, &options);
+    let defaults = |i: usize| {
+        if i == 0 {
+            "const f0 = () => g();".to_string()
+        } else {
+            format!("const f{i} = (a = f{}()) => a;", i - 1)
+        }
+    };
+    test_options_with_iterations(&dead_chain(13, defaults), "", 1, &options);
+    let mixed = |i: usize| match i {
+        0 => "function f0() { g() }".to_string(),
+        _ if i % 2 == 1 => format!("var f{i} = function () {{ f{}() }};", i - 1),
+        _ => format!("function f{i}() {{ f{}() }}", i - 1),
+    };
+    test_options_with_iterations(&dead_chain(13, mixed), "", 1, &options);
+}
+
+// The backward sweep leaves declarations with side-effecting initializers to
+// the next pass's forward walk, which keeps the side effects.
+#[test]
+fn dead_declarator_chain_keeps_side_effects() {
+    let source = "const a = () => g(); const b = (a(), () => a()); const c = () => b();";
+    test_options(source, "const a = () => g(); a();", &CompressOptions::dce());
+    test_smallest(source, "g();");
+    test_same_options(
+        "const a = () => g(); const b = () => a(); export const c = () => b();",
+        &CompressOptions::dce(),
+    );
+}
