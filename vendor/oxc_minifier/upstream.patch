+fn remove_dead_declarator_chain_with_side_effects_in_one_pass() {
+    let source = dead_chain(13, |i| match i {
+        0 => "const f0 = () => g();".to_string(),
+        _ => format!("const f{i} = (t({i}), () => f{}());", i - 1),
