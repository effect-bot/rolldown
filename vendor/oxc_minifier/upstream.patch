+// A removed declarator keeps its initializer's side effects in its place.
+#[test]
+fn dead_declarator_chain_keeps_side_effects() {
+    let source = "const a = () => g(); const b = (a(), () => a()); const c = () => b();";
+    test_options(source, "const a = () => g(); a();", &CompressOptions::dce());
+    test_smallest(source, "g();");
+    test_same_options(
+        "const a = () => g(); const b = () => a(); export const c = () => b();",
+        &CompressOptions::dce(),
+    );
+}
+
+// Links declared out of order are cleared in one pass too: each removal
+// rechecks the declarations it referenced, whatever their position.
+#[test]
+fn remove_dead_declarator_chain_declared_out_of_order() {
+    let order = (0..24).step_by(2).chain([23]).chain((1..23).step_by(2).rev());
+    let source = order
+        .map(|i| match i {
+            0 => "const f0 = () => g();".to_string(),
+            _ => format!("const f{i} = () => f{}();", i - 1),
+        })
+        .collect::<Vec<_>>()
+        .join("\n");
+    test_options_with_iterations(&source, "", 1, &CompressOptions::smallest());
+    test_options_with_iterations(&source, "", 1, &CompressOptions::dce());
+}
+
+// Links whose initializers have side effects go in one pass, and the side
+// effects stay in source order.
+#[test]
+fn remove_dead_declarator_chain_with_side_effects_in_one_pass() {
+    let source = dead_chain(13, |i| match i {
+        0 => "const f0 = () => g();".to_string(),
+        _ => format!("const f{i} = (t({i}), () => f{}());", i - 1),
+    });
+    let calls = (1..13).map(|i| format!("t({i})")).collect::<Vec<_>>();
+    // One dead declarator with a side effect takes two passes: the second
+    // settles the kept expression. A whole chain takes no more.
+    for options in [CompressOptions::smallest(), CompressOptions::dce()] {
+        test_options_with_iterations("const f1 = (t(1), () => 0);", "t(1);", 2, &options);
+    }
+    test_options_with_iterations(
+        &source,
+        &format!("{};", calls.join(", ")),
+        2,
+        &CompressOptions::smallest(),
+    );
+    test_options_with_iterations(
+        &source,
+        &format!("{};", calls.join("; ")),
+        2,
+        &CompressOptions::dce(),
+    );
+    // A removed declarator in the middle of a declaration splits it.
+    test_options(
+        "const a = 1, b = (t(), () => a), c = 2; export { c };",
+        "t(); const c = 2; export { c };",
+        &CompressOptions::dce(),
+    );
+}
