+// A removed declarator keeps its initializer's side effects in its place.
+#[test]
+fn dead_declarator_chain_keeps_side_effects() {
+    let source = "const a = () => g(); const b = (a(), () => a()); const c = () => b();";
+    test_options(source, "const a = () => g(); a();", &CompressOptions::dce());
+    test_smallest(source, "g();");
+    test_same_options(
+        "const a = () => g(); const b = () => a(); export const c = () => b();",
+        &CompressOptions::dce(),
+    );
+}
